@@ -0,0 +1,21 @@
+// Best effort: DELETE must precede close(), which aborts the HTTP transport.
+export async function terminateHttpSession(transport, logger) {
+    if (typeof transport.terminateSession !== 'function')
+        return;
+    let timer;
+    try {
+        await Promise.race([
+            Promise.resolve().then(() => transport.terminateSession()),
+            new Promise((_, reject) => {
+                timer = setTimeout(() => reject(new Error('session termination timed out')), 1000);
+            }),
+        ]);
+    }
+    catch {
+        // Do not mask a tool/connection error or log credential-bearing errors.
+        logger.warn('HTTP MCP session termination failed; closing transport anyway.');
+    }
+    finally {
+        clearTimeout(timer);
+    }
+}
