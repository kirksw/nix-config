#!/usr/bin/env bash
set -euo pipefail

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

if [[ $# -lt 1 ]]; then
  echo "${YELLOW}Usage:${NC} $0 <hostname> [--] [extra nix build args]"
  echo "${YELLOW}Example:${NC} $0 lunar"
  exit 2
fi

HOSTNAME="$1"; shift || true
FLAKE_SYSTEM="darwinConfigurations.${HOSTNAME}.system"

echo "${YELLOW}Starting build...${NC}"
nix --extra-experimental-features 'nix-command flakes' build ".#${FLAKE_SYSTEM}" "$@"

echo "${YELLOW}Cleaning up...${NC}"
if [ -L ./result ]; then
  unlink ./result
fi

echo "${GREEN}Building new generation complete!${NC}"
